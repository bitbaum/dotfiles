// Project workspace layout — shell panes that survive restart.
// Each tab opens a shell in the project directory.
// Type 'codex' or 'claude' to start an agent in any project tab.
// Type 'cockpit' in the Cockpit tab to start the web UI.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Revamp-Info" {
        pane cwd="/home/g/dev/revamp-info"
    }
    tab name="evig" {
        pane cwd="/home/g/dev/evig"
    }
    tab name="AOZ" {
        pane cwd="/home/g/dev/aoz-housing"
    }
    tab name="OC" {
        pane cwd="/home/g/dev/orangecat"
    }
    tab name="Kivvi" {
        pane cwd="/home/g/dev/kivvi"
    }
    tab name="OpenClaw" {
        pane cwd="/home/g/dev/openclaw"
    }
    tab name="Cockpit" {
        pane cwd="/home/g/dev/cockpit"
    }
    tab name="Dotfiles" {
        pane cwd="/home/g/dev/dotfiles"
    }
    tab name="Scratch" focus=true {
        pane cwd="/home/g"
    }
}
